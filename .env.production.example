# Database Configuration (USE STRONG CREDENTIALS)
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=muin_prod
DATABASE_URL=postgresql+asyncpg://admin:your_secure_password@db:5432/muin_prod

# Application Configuration
JWT_SECRET=generate_a_random_32_char_string
DEMO_MODE=false
LOG_LEVEL=WARNING

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=https://muin.yourdomain.com

# ML Configuration
MOCK_ML_MODE=false
BACKEND_URL=http://backend:8000/api/v1
MODEL_PATH=models/pothole_v1.pt
